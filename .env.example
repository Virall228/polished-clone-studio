# WAY Esports Environment Configuration
# Copy this file to .env and configure your values

# API Configuration
VITE_API_BASE_URL=http://localhost:3000

# Telegram Bot Configuration
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Social Links
VITE_TELEGRAM_CHANNEL=https://t.me/your_channel
VITE_DISCORD_INVITE=https://discord.gg/your_invite
VITE_TWITTER_URL=https://twitter.com/your_handle

# UI Enhancement Flag
# Set to true to enable polished UI mode
# In production, this is controlled by ENABLE_POLISHED_UI in config/env.ts
NODE_ENV=development